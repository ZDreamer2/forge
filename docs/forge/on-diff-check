#!/usr/bin/env python3
"""Validate installation tooling and packed integration without component source suites."""

import json
from pathlib import Path
import sys


def main() -> int:
    try:
        input_text = sys.stdin.read()
        payload = json.loads(input_text)
        root = Path(payload["root"])
        plugin = root / "ai/bc-plugins/dev/forge"
        sys.dont_write_bytecode = True
        sys.path.insert(0, str(plugin / "scripts"))
        sys.path.insert(0, str(plugin / "codebases/ts-react-frontend/scripts"))
        from frontend_diff_check import route_generation_files
        from pnpm_diff_check import Generation, main as check

        generation = None
        if payload["changes"]:
            app_root = (Path(__file__).resolve().parents[2] / "ui").relative_to(root).as_posix()
            generation = Generation(None, route_generation_files(root, app_root))
        return check(input_text, check_script="check:installation", generation=generation)
    except (ImportError, OSError, KeyError, TypeError, ValueError) as error:
        print(f"on-diff-check: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
