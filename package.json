{
	"name": "@zdreamer/forge",
	"version": "0.1.0",
	"description": "Forge workspace application and typed workspace policy contract",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZDreamer2/forge.git"
	},
	"homepage": "https://github.com/ZDreamer2/forge#readme",
	"bugs": "https://github.com/ZDreamer2/forge/issues",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/"
	],
	"bin": {
		"forge": "./dist/main.js"
	},
	"exports": {
		"./workspace": {
			"types": "./dist/workspace.d.ts",
			"default": "./dist/workspace.js"
		}
	},
	"engines": {
		"node": ">=24.18.1 <25"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit && biome check . && depcruise --config .dependency-cruiser.mjs 'src/**/*.ts' && node --test",
		"test:workspace": "node tools/workspace-consumer.ts"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@zdreamer/forge-ts-service": "0.1.1"
	}
}
