#!/usr/bin/env python3
"""Apply shared service fixes and validate the server without running UI/package gates."""

import json
from pathlib import Path
import sys


def main() -> int:
    try:
        input_text = sys.stdin.read()
        payload = json.loads(input_text)
        scripts = Path(payload["root"]) / "ai/bc-plugins/dev/forge/scripts"
        sys.dont_write_bytecode = True
        sys.path.insert(0, str(scripts))
        from pnpm_diff_check import main as check

        return check(input_text, check_script="check:server")
    except (ImportError, OSError, KeyError, TypeError, ValueError) as error:
        print(f"on-diff-check: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
