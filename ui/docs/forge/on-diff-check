#!/usr/bin/env python3
"""Verify the frontend through shared capabilities and the standalone host binding."""

import json
from pathlib import Path
import sys


def main() -> int:
    try:
        input_text = sys.stdin.read()
        payload = json.loads(input_text)
        plugin = Path(payload["root"]) / "ai/bc-plugins/dev/forge"
        sys.dont_write_bytecode = True
        sys.path.insert(0, str(plugin / "scripts"))
        sys.path.insert(0, str(plugin / "codebases/ts-react-frontend/scripts"))
        from frontend_diff_check import main as check

        return check(input_text, app_root="library/tools/forge/ui", check_script="check:ui", generate_script="build:ui")
    except (ImportError, OSError, KeyError, TypeError, ValueError) as error:
        print(f"on-diff-check: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
